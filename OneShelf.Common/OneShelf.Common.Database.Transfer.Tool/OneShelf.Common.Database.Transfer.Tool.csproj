<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copies the songs, dog and dragon databases from SQL Server to PostgreSQL; run by hand. See TransferTool. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <IsPackable>false</IsPackable>
  </PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\OneShelf.Common.Database.Transfer\OneShelf.Common.Database.Transfer.csproj" />
	  <ProjectReference Include="..\OneShelf.Common.Database.Songs.PostgreSqlMigrations\OneShelf.Common.Database.Songs.PostgreSqlMigrations.csproj" />
	  <ProjectReference Include="..\..\OneShelf.OneDog\OneShelf.OneDog.Database.PostgreSqlMigrations\OneShelf.OneDog.Database.PostgreSqlMigrations.csproj" />
	  <ProjectReference Include="..\..\OneShelf.OneDragon\OneShelf.OneDragon.Database.PostgreSqlMigrations\OneShelf.OneDragon.Database.PostgreSqlMigrations.csproj" />
	</ItemGroup>

</Project>
