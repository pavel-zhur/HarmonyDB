@* The styles of the shelf's people pages. *@
<style>
    .shelf-chip {
        display: inline-block;
        padding: 1px 7px;
        margin: 1px 2px 1px 0;
        border-radius: 10px;
        font-size: 0.8rem;
        background: #e8eef7;
        color: #1b3a63;
        white-space: nowrap;
    }
    .shelf-chip.custom { background: #fbeedd; color: #6b3d00; }
    .shelf-chip.unknown { background: #eee; color: #777; text-decoration: line-through; }
    .shelf-chip.added { background: #dff3e3; color: #145a24; }
    .shelf-chip.removed { background: #f8e0e0; color: #7a1c1c; }
    .shelf-muted { color: #888; font-size: 0.85rem; }
    .shelf-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; background: #ddd; }
    .shelf-avatar.big { width: 64px; height: 64px; }
    .shelf-table td, .shelf-table th { vertical-align: top; padding: 6px 10px 6px 0; }
    .shelf-ticks { margin-bottom: 18px; }
    .shelf-ticks h5 { margin: 18px 0 6px; }
    .shelf-ticks label { cursor: pointer; }
    .shelf-ticks .form-check { margin-bottom: 4px; }
    .shelf-music td { padding: 4px 18px 4px 0; }
</style>
