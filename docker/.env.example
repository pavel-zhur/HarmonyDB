# Copy to .env (not committed) and fill in.

# ---------- the stack ----------
# the name of the stack: its containers, volumes and network are named after it (the network: <name>_default)
COMPOSE_PROJECT_NAME=

# ---------- PostgreSQL ----------
# the password of the administrator (postgres)
POSTGRES_PASSWORD=
# the database; each service has its own role in it, whose search_path is its own schema
# (made with OneShelf.Common/OneShelf.Common.Database/CreateServiceRole.sql, see docs/database-move.md)
PG_DATABASE=
PG_ROLE_SONGS=
PG_PASSWORD_SONGS=
PG_SCHEMA_SONGS=
PG_ROLE_ONEDOG=
PG_PASSWORD_ONEDOG=
PG_SCHEMA_ONEDOG=
PG_ROLE_ONEDRAGON=
PG_PASSWORD_ONEDRAGON=
PG_SCHEMA_ONEDRAGON=
PG_ROLE_COLLECTIVES=
PG_PASSWORD_COLLECTIVES=
PG_SCHEMA_COLLECTIVES=
PG_ROLE_ILLUSTRATIONS=
PG_PASSWORD_ILLUSTRATIONS=
PG_SCHEMA_ILLUSTRATIONS=
PG_ROLE_FRONTEND=
PG_ROLE_ANALYSES=
PG_PASSWORD_FRONTEND=
PG_PASSWORD_ANALYSES=
PG_SCHEMA_FRONTEND=

# ---------- the transfer from SQL Server and Cosmos DB to PostgreSQL (run by hand, see Songs' transfer.ps1) ----------
# the docker network where both databases are reached (the stack's network, <COMPOSE_PROJECT_NAME>_default),
# and the host of PostgreSQL in it (the stack's service: postgres)
TRANSFER_NETWORK=
PG_HOST=
# the SQL Server read from, as an administrator
TRANSFER_SOURCE_SQL_HOST=
TRANSFER_SOURCE_SQL_DATABASE=
TRANSFER_SOURCE_SQL_USER=
TRANSFER_SOURCE_SQL_PASSWORD=
# the users whose default schemas hold the services' tables there
TRANSFER_SOURCE_SQL_USER_SONGS=
TRANSFER_SOURCE_SQL_USER_ONEDOG=
TRANSFER_SOURCE_SQL_USER_ONEDRAGON=
# the export of Cosmos DB the collectives and the illustrations are loaded from: the directory of its files,
# a file per container (<container>.jsonl, a document per line), and the name of the collectives' container's file
TRANSFER_COSMOS_EXPORT_DIRECTORY=
TRANSFER_COSMOS_EXPORT_COLLECTIVES_FILE=

# ---------- between the services ----------
# the key of the functions of the "Function" level of every module (in "?code=" or the "x-functions-key" header),
# also the key of the PDF service
FUNCTIONS_KEY=
# what a service presents to be trusted as a service
SERVICE_CODE=
# The local way in without Telegram. Leave ALLOW_BAD_HASH empty anywhere other people can reach: with it true,
# a login of ANY user is accepted when it carries BAD_HASH in place of Telegram's hash, and the site itself
# hands BAD_HASH to every visitor (in its settings and in its /enter.html page).
ALLOW_BAD_HASH=
BAD_HASH=
# signs the links of the PDF previews
QUICK_CHECK_SECRET=
# the connection string of the API's Application Insights (its requests, the calls it makes, the modules' logs);
# empty: none
API_APPINSIGHTS_CONNECTION_STRING=

# ---------- collectives (the songs people add themselves) ----------
# the address of a collective song: {0} its id, {1} its tag, {2} its version; and the pattern that finds the id in it
# (in the pattern, write $$ for $)
COLLECTIVES_URL_TEMPLATE=
COLLECTIVES_URL_ID_PATTERN=
# the host of those addresses, and how the source is called
SELF_HOST=
SELF_SOURCE_NAME=
SELF_SHORT_SOURCE_NAME=
# the prefix of its songs' ids: the short name in lower case and a dash
SELF_EXTERNAL_ID_PREFIX=
# the address of own chords the source gives through the source contract, version 2 (their public page), with {id},
# {code} and {version}
SELF_ADDRESS_TEMPLATE=

# ---------- analyses ----------
# the analyses as a source: its key and the title it is shown by, an analysis's address on the public page with {id}
# where its id goes, and the key of the client "analyses" that puts analyses in (long random text, at least 32)
ANALYSES_SOURCE_KEY=
ANALYSES_SOURCE_TITLE=
ANALYSES_PUBLIC_URI_TEMPLATE=
ANALYSES_WRITE_KEY=
# the key of the index at the analyses, which reads them as a source (the same kind of text)
ANALYSES_INDEX_KEY=

# ---------- illustrations ----------
# the address of the Illustrations module as browsers reach it, ending with "/illustrations/api/"
# (e.g. http://localhost:<API_PORT>/illustrations/api/): the pictures are shown from it
ILLUSTRATIONS_PUBLIC_ENDPOINT=

# ---------- OpenAI ----------
OPENAI_API_KEY=
# music (Google Vertex AI): the key file of a service account as one line of JSON, in single quotes
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
# videos (Google Veo, Azure OpenAI Sora)
GOOGLE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
# the models of the illustrations, required when OPENAI_API_KEY is set: the chat model that writes their prompts and
# the image model that draws them
OPENAI_SONG_IMAGES_PROMPTS_MODEL=gpt-6.1-terra
OPENAI_SONG_IMAGES_MODEL=gpt-image-2.6-flare

# ---------- the PDF service ----------
# the licence key of the Syncfusion HTML to PDF converter
SYNCFUSION_LICENSE_KEY=

# ---------- the bots ----------
# the Telegram user who administers them
TELEGRAM_ADMIN_ID=

# the library bot (its token is also the one whose Telegram logins the Authorization module accepts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# any value: the poller presents it to the bot
TELEGRAM_WEBHOOK_SECRET=
# the tenant whose library the bot serves
TELEGRAM_TENANT_ID=
# chats are written as @name
TELEGRAM_FILES_CHAT_ID=
TELEGRAM_PUBLIC_LIBRARY_CHAT_ID=
TELEGRAM_PUBLIC_DOG_CHAT_ID=
TELEGRAM_PUBLIC_TOPIC_ID=
TELEGRAM_ANNOUNCEMENTS_TOPIC_ID=
TELEGRAM_OWN_CHATTER_TOPIC_ID=
TELEGRAM_NEVER_PROMOTE_STICKER_FILE_ID=
# parts of the addresses of chords the bot picks up from the chat
TELEGRAM_REACT_TO_URL_0=
TELEGRAM_REACT_TO_URL_1=
TELEGRAM_REACT_TO_URL_2=
TELEGRAM_REACT_TO_URL_3=
TELEGRAM_REACT_TO_URL_4=
# true or false (when empty, false): the hourly rebuild of the library in the chat, and the daily selection sent to the users
TELEGRAM_HOURLY=
TELEGRAM_DAILY_SELECTION=

ONEDRAGON_BOT_TOKEN=
ONEDRAGON_WEBHOOK_SECRET=

# ---------- the admin site ----------
# It has no login of its own: whoever reaches its address is in. Where it is reachable by others, it has to stand
# behind something that lets only its people through.
ADMIN_TENANT_ID=

# ---------- the frontend site ----------
# the environment the application starts in; "Development" shows the "enter without Telegram" link
FRONTEND_ENVIRONMENT=
# the connection string of its Application Insights
FRONTEND_APPINSIGHTS_CONNECTION_STRING=
# with ALLOW_BAD_HASH true: who the site's /enter.html page logs the browser in as (a Telegram user's id, name, username)
LOCAL_IDENTITY_ID=
LOCAL_IDENTITY_FIRST_NAME=
LOCAL_IDENTITY_USERNAME=

# ---------- the internal clients' keys (long random text of letters and digits, at least 32) ----------
# the index at the own chords' source; the new shelf at the index, the own chords' store and their editor's preview,
# the illustrations, the PDF service and the music service; the import from the old shelf at the index and the
# illustrations; the admin site at the new shelf
SELF_INDEX_KEY=
INDEX_SHELF_KEY=
COLLECTIVES_SHELF_KEY=
SELF_SHELF_KEY=
ILLUSTRATIONS_SHELF_KEY=
PDFS_SHELF_KEY=
AUDIO_SHELF_KEY=
INDEX_IMPORT_KEY=
ILLUSTRATIONS_IMPORT_KEY=
SHELF_ADMIN_KEY=
# ---------- the new shelf (HarmonyDB.Shelf) ----------
# the passwords of the roles "shelf" and "audio", which own the databases of the same names (made with
# OneShelf.Common/OneShelf.Common.Database/CreateServiceDatabase.sql)
SHELF_DB_PASSWORD=
AUDIO_DB_PASSWORD=
# the key of what the shelf keeps encrypted, and the key the media addresses are signed with: 32 random bytes each,
# base64 (openssl rand -base64 32)
SHELF_SECRETS_KEY=
SHELF_MEDIA_SIGNING_KEY=
# the environment ("Development" on a local stack: it allows the dev sign-in and a plain http origin), the address the
# app is opened at (http://localhost:<SHELF_WEB_PORT> locally) and the address of its public page
# (http://localhost:<PUBLIC_WEB_PORT> locally)
SHELF_ENVIRONMENT=
SHELF_PUBLIC_ORIGIN=
SHELF_SITE_ORIGIN=
# the id of the playlist the public page shows as its showcase; empty: none
SHELF_SHOWCASE_PLAYLIST_ID=
# which sign-ins are on (true / false); the dev one works only in Development
SHELF_SIGNIN_DEV=
SHELF_SIGNIN_TELEGRAM=
SHELF_SIGNIN_GOOGLE=
SHELF_SIGNIN_YANDEX=
# the Telegram (BotFather, Login Widget), Google and Yandex clients (their redirect address is
# <SHELF_PUBLIC_ORIGIN>/api/auth/callback/telegram, .../google, .../yandex)
SHELF_TELEGRAM_CLIENT_ID=
SHELF_TELEGRAM_CLIENT_SECRET=
SHELF_GOOGLE_CLIENT_ID=
SHELF_GOOGLE_CLIENT_SECRET=
SHELF_YANDEX_CLIENT_ID=
SHELF_YANDEX_CLIENT_SECRET=
# the subnet of the network of the shelf's web servers and its API (CIDR, e.g. 172.18.0.0/16, free on the host): the
# shelf believes the X-Forwarded-For of what comes from it
SHELF_WEB_SUBNET=
# the networks of the proxies in front of the shelf's web servers (CIDR, separated by spaces), whose X-Forwarded-For
# gives the visitor's address; empty when visitors reach the web servers straight (the local stack)
SHELF_EDGE_PROXIES=
# the custom permissions: a key and the label the admin site shows for it, per permission (up to four: 0 ... 3); a
# line left in with no value stops the shelf at start, so only the ones used are written
# Permissions__Custom__0__Key=
# Permissions__Custom__0__Label=
# what a new person gets (existing accounts do not change when this changes): permissions by their names (pdf, ...),
# custom ones by their keys, up to four; a line left in with no value stops the shelf at start
# Permissions__Defaults__NewAccount__0=pdf
# ---------- the music service (HarmonyDB.Audio) ----------
# the two constants of Yandex's client, the largest file kept from an address (bytes), and the folder with the
# service accounts' files (yandex-token, youtube-auth.json)
MUSIC_YANDEX_SIGN_KEY=
MUSIC_YANDEX_MP3_SALT=
AUDIO_MAX_URL_FILE_BYTES=
AUDIO_SECRETS_DIR=
# ---------- ports published on the host ----------
POSTGRES_PORT=14432
API_PORT=14001
FRONTEND_WEB_PORT=14003
ADMIN_WEB_PORT=14004
PDFS_API_PORT=14007
PLAYGROUND_WEB_PORT=14008
STATIC_WEB_PORT=14009
SHELF_WEB_PORT=14100
SHELF_API_PORT=14101
PUBLIC_WEB_PORT=14109
