# Copy to .env (not committed) and fill in.

# ---------- SQL Server ----------
# the password of the administrator (sa)
SQL_SA_PASSWORD=
# the database; each service has its own user in it, whose default schema holds the service's tables
SQL_DATABASE=
SQL_USER_SONGS=
SQL_PASSWORD_SONGS=
SQL_USER_ONEDOG=
SQL_PASSWORD_ONEDOG=
SQL_USER_ONEDRAGON=
SQL_PASSWORD_ONEDRAGON=

# ---------- Cosmos DB emulator ----------
# the emulator's fixed, publicly documented key
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE=
# the collectives container is "Collective-<postfix>"
COLLECTIVES_CONTAINER_POSTFIX=

# ---------- Azurite ----------
# the storage emulator's fixed, publicly documented key
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# ---------- between the services ----------
# the key of every functions app (the "code" of its functions)
FUNCTIONS_KEY=
# what a service presents to be trusted as a service
SERVICE_CODE=
# the hash the Authorization service accepts instead of a Telegram one
BAD_HASH=
# signs the links of the PDF previews
QUICK_CHECK_SECRET=

# ---------- collectives (the songs people add themselves) ----------
# the address of a collective song: {0} its id, {1} its tag, {2} its version; and the pattern that finds the id in it
# (in the pattern, write $$ for $)
COLLECTIVES_URL_TEMPLATE=
COLLECTIVES_URL_ID_PATTERN=
# the host of those addresses, and how the source is called
SELF_HOST=
SELF_SOURCE_NAME=
SELF_SHORT_SOURCE_NAME=
# the prefix of its songs' ids: the short name in lower case and a dash
SELF_EXTERNAL_ID_PREFIX=

# ---------- OpenAI ----------
OPENAI_API_KEY=
# music (Google Vertex AI): the key file of a service account as one line of JSON, in single quotes
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
# videos (Google Veo, Azure OpenAI Sora)
GOOGLE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# ---------- the PDF service ----------
# the licence key of the Syncfusion HTML to PDF converter
SYNCFUSION_LICENSE_KEY=

# ---------- the bots ----------
# the Telegram user who administers them
TELEGRAM_ADMIN_ID=

# the library bot (its token is also the one whose Telegram logins the Authorization service accepts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# any value: the poller presents it to the bot service
TELEGRAM_WEBHOOK_SECRET=
# the tenant whose library the bot serves
TELEGRAM_TENANT_ID=
# chats are written as @name
TELEGRAM_FILES_CHAT_ID=
TELEGRAM_PUBLIC_LIBRARY_CHAT_ID=
TELEGRAM_PUBLIC_DOG_CHAT_ID=
TELEGRAM_PUBLIC_TOPIC_ID=
TELEGRAM_ANNOUNCEMENTS_TOPIC_ID=
TELEGRAM_OWN_CHATTER_TOPIC_ID=
TELEGRAM_NEVER_PROMOTE_STICKER_FILE_ID=
# parts of the addresses of chords the bot picks up from the chat
TELEGRAM_REACT_TO_URL_0=
TELEGRAM_REACT_TO_URL_1=
TELEGRAM_REACT_TO_URL_2=
TELEGRAM_REACT_TO_URL_3=
TELEGRAM_REACT_TO_URL_4=

ONEDRAGON_BOT_TOKEN=
ONEDRAGON_WEBHOOK_SECRET=

# ---------- the admin site ----------
ADMIN_TENANT_ID=
# what to enter on its login page
ADMIN_PASSWORD=

# ---------- the frontend site ----------
# the environment the application starts in; "Development" shows the "enter without Telegram" link
FRONTEND_ENVIRONMENT=
# the connection string of its Application Insights
FRONTEND_APPINSIGHTS_CONNECTION_STRING=
# who the site's /enter.html page logs the browser in as, without Telegram: a Telegram user's id, name and username
LOCAL_IDENTITY_ID=
LOCAL_IDENTITY_FIRST_NAME=
LOCAL_IDENTITY_USERNAME=

# ---------- ports published on the host ----------
SQL_PORT=13433
AZURITE_BLOB_PORT=13000
INDEX_API_PORT=13001
AUTHORIZATION_API_PORT=13002
FRONTEND_WEB_PORT=13003
ADMIN_WEB_PORT=13004
ILLUSTRATIONS_API_PORT=13005
BILLING_API_PORT=13006
PDFS_API_PORT=13007
PLAYGROUND_WEB_PORT=13008
COLLECTIVES_API_PORT=13009
SOURCES_SELF_API_PORT=13010
FRONTEND_API_PORT=13011
TELEGRAM_RUNNER_PORT=13012
COSMOS_PORT=13013
ONEDOG_RUNNER_PORT=13014
COSMOS_EXPLORER_PORT=13015
ONEDRAGON_RUNNER_PORT=13016
