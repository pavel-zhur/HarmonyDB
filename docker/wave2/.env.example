# Copy to .env (not committed) and fill in.

# the password of the administrator (postgres) of the shared stack's PostgreSQL: the init job creates the databases
# with it
POSTGRES_PASSWORD=

# the passwords of the roles "shelf" and "audio", which own the databases of the same names (long random text of
# letters and digits)
SHELF_DB_PASSWORD=
AUDIO_DB_PASSWORD=

# the key of what the shelf keeps encrypted: 32 random bytes, base64 (openssl rand -base64 32)
SHELF_SECRETS_KEY=

# wave2-api: the old services on the old databases, with the same settings as the shared stack's "api" (copy them from
# its .env)
PG_DATABASE=
PG_ROLE_SONGS=
PG_PASSWORD_SONGS=
PG_ROLE_ONEDOG=
PG_PASSWORD_ONEDOG=
PG_ROLE_ONEDRAGON=
PG_PASSWORD_ONEDRAGON=
PG_ROLE_COLLECTIVES=
PG_PASSWORD_COLLECTIVES=
PG_ROLE_ILLUSTRATIONS=
PG_PASSWORD_ILLUSTRATIONS=
PG_ROLE_FRONTEND=
PG_PASSWORD_FRONTEND=
FUNCTIONS_KEY=
SERVICE_CODE=
COLLECTIVES_URL_TEMPLATE=
COLLECTIVES_URL_ID_PATTERN=
SELF_HOST=
SELF_SOURCE_NAME=
SELF_SHORT_SOURCE_NAME=
SELF_EXTERNAL_ID_PREFIX=
ILLUSTRATIONS_PUBLIC_ENDPOINT=
OPENAI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
GOOGLE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
# wave2-api: the OpenAI models of the illustrations: the chat model that writes their prompts (Chat Completions with
# function calling and several choices) and the image model that draws them (the Images API)
OPENAI_SONG_IMAGES_PROMPTS_MODEL=
OPENAI_SONG_IMAGES_MODEL=

# wave2-api: the keys of its internal clients (long random text of letters and digits, at least 32): the index at the
# own chords, the shelf at the index, the shelf at the illustrations
WAVE2_SELF_INDEX_KEY=
WAVE2_INDEX_SHELF_KEY=
WAVE2_ILLUSTRATIONS_SHELF_KEY=
# wave2-api: the shelf's keys at the own chords' store and at their editor's preview (the same kind of text)
WAVE2_COLLECTIVES_SHELF_KEY=
WAVE2_SELF_SHELF_KEY=
# shelf-api: the own chords' source's key there, to ask which Telegram users an account is (the same kind of text)
WAVE2_SHELF_SELF_KEY=
# wave2-api: the key of the import from the old shelf (shelf-import) at the index (the same kind of text)
WAVE2_INDEX_IMPORT_KEY=
# wave2-api: the key of the import (shelf-import) at the illustrations, where it puts the old illustrations' aliases (the
# same kind of text)
WAVE2_ILLUSTRATIONS_IMPORT_KEY=
# one more internal client of the index
WAVE2_INDEX_TOOLS_KEY=

# wave2-pdfs: the converter's licence key (copy it from the shared stack's .env), and the shelf's key there (the same
# kind of text as the keys above)
SYNCFUSION_LICENSE_KEY=
WAVE2_PDFS_SHELF_KEY=

# shelf-api: the environment ("Development" on the local stack: it allows the dev sign-in and a plain http origin) and
# the address the app is opened at (http://localhost:14100 locally; the https address when deployed)
SHELF_ENVIRONMENT=
SHELF_PUBLIC_ORIGIN=
# shelf-api: which sign-ins are on (true / false); the dev one works only in Development
SHELF_SIGNIN_DEV=
SHELF_SIGNIN_TELEGRAM=
SHELF_SIGNIN_GOOGLE=
SHELF_SIGNIN_YANDEX=
# shelf-api: the Telegram (BotFather, Login Widget), Google and Yandex clients (their redirect address is
# <SHELF_PUBLIC_ORIGIN>/api/auth/callback/telegram, …/google, …/yandex)
SHELF_TELEGRAM_CLIENT_ID=
SHELF_TELEGRAM_CLIENT_SECRET=
SHELF_GOOGLE_CLIENT_ID=
SHELF_GOOGLE_CLIENT_SECRET=
SHELF_YANDEX_CLIENT_ID=
SHELF_YANDEX_CLIENT_SECRET=
# the shelf's key at the music service (long random text of letters and digits, at least 32)
WAVE2_AUDIO_SHELF_KEY=
# shelf-api: the key the media addresses are signed with: 32 random bytes, base64 (openssl rand -base64 32). It calls the
# index with WAVE2_INDEX_SHELF_KEY
SHELF_MEDIA_SIGNING_KEY=
# shelf-api: the network of the reverse proxy in front of it, whose X-Forwarded-For is believed (CIDR): this project's
# own network, pinned in docker-compose.yml (networks: default) — 172.18.0.0/16. Must be set whenever a proxy stands in
# front, or every client has the proxy's address and shares one rate limit
SHELF_TRUSTED_PROXY_NETWORK=
# shelf-api: its own analyses as a source — the source's key and the title it is shown by; the keys (long random text
# of letters and digits, at least 32) of the index, which reads it as a source, and of the client that puts analyses in
SHELF_ANALYSES_SOURCE_KEY=
SHELF_ANALYSES_SOURCE_TITLE=
WAVE2_SHELF_INDEX_KEY=
WAVE2_SHELF_ANALYSES_KEY=
# shelf-api: the custom permissions — a key and the label the admin site shows for it, per permission (up to four:
# 0 … 3); a line left in with no value stops the shelf at start, so only the ones used are written
# Permissions__Custom__0__Key=
# Permissions__Custom__0__Label=

# wave2-admin: the admin site's key at the shelf (long random text of letters and digits, at least 32), and the tenant
# its old pages show (as the shared stack's ADMIN_TENANT_ID)
WAVE2_SHELF_ADMIN_KEY=
ADMIN_TENANT_ID=

# audio-api: the two constants of Yandex's client, the largest blob and the largest file kept from an address (bytes),
# and the folder with the service accounts' files (yandex-token, youtube-auth.json)
MUSIC_YANDEX_SIGN_KEY=
MUSIC_YANDEX_MP3_SALT=
AUDIO_MAX_BLOB_BYTES=
AUDIO_MAX_URL_FILE_BYTES=
WAVE2_SECRETS_DIR=
