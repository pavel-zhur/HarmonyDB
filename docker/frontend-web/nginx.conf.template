# The frontend site and, on the same address, the two modules of the API it calls from the browser
# (so that the browser does not make cross-origin requests; in Azure the services allow them themselves).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 50m;

    # The API's address is looked up (in Docker's DNS) when requests come, not once at start: the API's container
    # can be recreated and get another address while this one keeps running.
    resolver 127.0.0.11 valid=10s;
    set $api api;

    location /frontend-api/ {
        rewrite ^/frontend-api/(.*)$ /frontend/$1 break;
        proxy_pass http://$api;
        proxy_read_timeout 300s;
    }

    location /collectives-api/ {
        rewrite ^/collectives-api/(.*)$ /collectives/$1 break;
        proxy_pass http://$api;
        proxy_read_timeout 300s;
    }

    # the navigation fallback: an address that is not a file is the site itself
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        # the environment the application starts in
        add_header Blazor-Environment "${BLAZOR_ENVIRONMENT}";

        # the copies compressed at build time (see the Dockerfile); the files changed at start (configure.sh) have
        # none and are compressed when sent
        gzip_static on;
        gzip on;
        gzip_vary on;
        gzip_comp_level 6;
        gzip_types application/javascript application/json text/css;
    }
}
