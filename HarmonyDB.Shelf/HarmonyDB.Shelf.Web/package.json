{
  "name": "harmonydb-shelf-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "openapi-typescript ../HarmonyDB.Shelf.Model/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "test": "node --test --experimental-transform-types --no-warnings --import ./build/test-hooks.mjs \"src/**/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@soundtouchjs/core": "2.1.1",
    "@tanstack/react-query": "5.106.1",
    "i18next": "26.7.1",
    "openapi-fetch": "0.17.0",
    "opensheetmusicdisplay": "2.3.1",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.1.11",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
